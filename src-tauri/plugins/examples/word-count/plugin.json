{
  "id": "example.word-count",
  "name": "字数统计",
  "version": "1.0.0",
  "apiVersion": 1,
  "description": "统计当前笔记的中文字符、英文词数、标题数和预计阅读时间。",
  "author": "页边示例",
  "main": "main.js",
  "permissions": ["notes:read"],
  "settings": [
    {
      "key": "includeCode",
      "label": "包含代码 / HTML 块",
      "type": "boolean",
      "default": true
    }
  ],
  "commands": [
    {
      "id": "count",
      "title": "统计当前笔记字数",
      "description": "返回字数、标题数、链接数和预计阅读时间。",
      "context": "note"
    }
  ]
}
