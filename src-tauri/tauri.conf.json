{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "页边笔记",
  "version": "0.1.0",
  "identifier": "com.yebian.notes",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "页边笔记",
        "width": 1440,
        "height": 900,
        "minWidth": 1040,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: https://*.hdslb.com https://*.bilibili.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; connect-src ipc: http://ipc.localhost ws://localhost:1420 http://localhost:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../sample-vault/*.md": "sample-vault/",
      "../sample-vault/ScribeFlow/*.md": "sample-vault/ScribeFlow/",
      "../sample-vault/.yebian-vault": "sample-vault/.yebian-vault"
    },
    "category": "Productivity",
    "shortDescription": "本地笔记阅读器：标签、关系图、段落标注。",
    "longDescription": "页边笔记是本地优先的笔记阅读器：中间读正文，右侧看一跳关系与标注；标注存在本地 SQLite，锚点丢失会明确提示。",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese"
        ],
        "displayLanguageSelector": false
      }
    }
  }
}
